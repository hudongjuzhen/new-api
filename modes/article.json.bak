          "type": "longtext"
        }
      ]
    },
    {
      "id": "claims",
      "label": "论点库",
      "dir": "claims",
      "itemFile": "item.json",
      "fields": [
        {
          "key": "name",
          "label": "论点名称",
          "type": "text"
        },
        {
          "key": "body",
          "label": "主张",
          "type": "longtext"
        },
        {
          "key": "stance",
          "label": "立场",
          "type": "select",
          "options": [
            "主张",
            "反对",
            "存疑"
          ]
