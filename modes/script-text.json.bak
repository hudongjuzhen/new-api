{
  "format": "aimv-work-mode",
  "formatVersion": 1,
  "x-visibility": "public",
  "x-summary": "剧本：按场次写对白与动作，适合短剧与舞台本。",
  "id": "script-text",
  "label": "剧本",
  "medium": "text",
  "workScale": "serial",
  "words": {
    "audio": "导入音频",
    "audioNone": "",
    "audioShort": "音频",
    "text": "剧本正文",
    "textImport": "",
    "textExport": "",
    "textNone": "",
    "planDialog": "AI 全集规划",
    "shotDialog": "版本",
    "shot": "段落",
    "segment": "场",
    "nodeInput": "任务需要这一段剧本正文作为节点输入。",
    "statement": "整集",
    "textPlain": "",
    "textNoneHint": "",
    "refSection": "【参考（按类型）】",
    "segments": "分场",
    "planning": "正在规划这一集的场次…",
    "writing": "模型正在按梗概与人物设定写这一集的剧本（这一趟不带音频，它读的是文字）。",
    "whole": "整集",
    "wholeSegment": "",
    "singShots": "成场",
    "planSelfCheck": {
      "musicName": "",
      "musicUse": "这一趟不带音频 —— 场次由模型按梗概自己划分",
      "textName": "",
      "textUse": "剧本正文是唯一的交付物：场景标题（内/外 · 地点 · 时间）+ 动作段 + 人物名顶格的对白，这个格式不许改（它是给人读的，不是给模型读的）",
      "refName": "参考",
      "refUse": "「资料」提供事实与年代细节；「实体」是人物表与地点表；「文风」定语感",
      "segName": "",
      "segUse": "每一场单独成稿、按顺序接起来就是一集"
    },
    "notNeeded": "这一项在当前模式下不是必填的 —— 不填也能开始规划。",
    "audioScript": "AI 生成音频脚本",
    "audioGenerate": "生成音频",
    "audioScriptName": "音频脚本",
    "audioGenerateHint": "这一屏要发出去的音频提示词（音色表 + 音频脚本）。"
  },
  "appRows": {
    "sd": "5",
    "hd": "10",
    "upscale": "9",
    "faceswap": "12",
    "edit": "11"
  },
  "lipSync": {
    "when": "byScenario",
    "text": "人物开口时，嘴唇与下颌要随音频逐音节精准开合，只在真正出声的音节上开闭，绝不脱离音频独立动作。（这一档交付的是文字，没有画面。）"
  },
  "requires": {
    "audio": false,
    "lyrics": false,
    "refs": true,
    "segments": false
  },
  "core": "prompt",
  "coreLabels": {
    "audio": "参考音频",
    "prompt": "梗概与人物设定"
  },
  "planDialog": {
    "label": "AI 全集规划",
    "title": "AI 全集规划",
    "templates": [
      "请你作为编剧，结合这一集的梗概与人物设定，来规划这一集的场次与节奏：",
      "请你作为编剧，结合这一集的梗概与人物设定，来规划这一集的场次与节奏：\n三幕搭法：第一场把人物推进一个他躲不开的处境，中段让处境变坏，最后一场他必须做一个选择。",
      "请你作为编剧，结合这一集的梗概与人物设定，来规划这一集的场次与节奏：\n英雄之旅：从日常被打破写起，经过一次彻底的失败，再到他带着那个代价回来——每一场都要推进其中一步。",
      "请你作为编剧，结合这一集的梗概与人物设定，来规划这一集的场次与节奏：\n群像：每一场换一个视角人物，他们各自要的东西互相绊住对方，没有谁是反派。",
      "请你作为编剧，结合这一集的梗概与人物设定，来规划这一集的场次与节奏：\n反转：前几场给的每一个信息都要有第二种解释，最后一场只用已有的信息把第二种解释翻上来。",
      "请你作为编剧，结合这一集的梗概与人物设定，来规划这一集的场次与节奏：\n对白驱动：少写动作，靠两个人说的话把关系和底牌一层层揭开，每场结束时局面与开场时不同。"
    ]
  },
  "shotDialog": {
    "label": "版本"
  },
  "extraButtons": [],
  "libraries": [
    {
      "id": "works",
      "label": "作品库",
      "dir": "works",
      "itemFile": "item.json",
      "fields": [
        {
          "key": "name",
          "label": "作品名称",
          "type": "text"
        }
      ]
    },
    {
      "id": "materials",
      "label": "资料库",
      "dir": "materials",
      "itemFile": "item.json",
      "fields": [
        {
          "key": "name",
          "label": "资料名称",
          "type": "text"
        },
        {
          "key": "materialKind",
          "label": "资料类型",
          "type": "select",
          "options": [
            "文字",
            "图片",
            "音频",
            "视频",
            "其他"
          ]
        },
        {
          "key": "body",
          "label": "正文",
          "type": "longtext"
        },
        {
          "key": "primary",
          "label": "图片",
          "type": "image"
        },
        {
          "key": "videoFile",
          "label": "视频",
          "type": "video"
        },
        {
          "key": "audioFile",
          "label": "音频",
          "type": "audio"
        },
        {
          "key": "source",
          "label": "来源",
          "type": "longtext"
        },
        {
          "key": "note",
          "label": "备注",
          "type": "longtext"
        }
      ]
    },
    {
      "id": "excerpts",
      "label": "摘录库",
      "dir": "excerpts",
      "itemFile": "item.json",
      "fields": [
        {
          "key": "name",
          "label": "摘录名称",
          "type": "text"
        },
        {
          "key": "body",
          "label": "摘录正文",
          "type": "longtext"
        },
        {
          "key": "source",
          "label": "出处",
          "type": "text"
        },
        {
          "key": "note",
          "label": "我的批注",
          "type": "longtext"
        }
      ]
    },
    {
      "id": "entities",
      "label": "实体库",
      "dir": "entities",
      "itemFile": "item.json",
      "fields": [
        {
          "key": "name",
          "label": "实体名称",
          "type": "text"
        },
        {
          "key": "entityClass",
          "label": "类别",
          "type": "select",
          "options": [
            "人物",
            "地点",
            "组织",
            "概念",
            "事件",
            "作品"
          ]
        },
        {
          "key": "alias",
          "label": "别名",
          "type": "text"
        },
        {
          "key": "brief",
          "label": "简述",
          "type": "longtext"
        }
      ]
    },
    {
      "id": "claims",
      "label": "论点库",
      "dir": "claims",
      "itemFile": "item.json",
      "fields": [
        {
          "key": "name",
          "label": "论点名称",
          "type": "text"
        },
        {
          "key": "body",
          "label": "主张",
          "type": "longtext"
        },
        {
          "key": "stance",
          "label": "立场",
          "type": "select",
          "options": [
            "主张",
            "反对",
            "存疑"
          ]
        },
        {
          "key": "evidence",
          "label": "证据",
          "type": "longtext"
        }
      ]
    }
  ]
}
